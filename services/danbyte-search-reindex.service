[Unit]
Description=Danbyte global search index rebuild
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py rebuild_search_index

# Triggered nightly by danbyte-search-reindex.timer.
# Logs: journalctl --user -fu danbyte-search-reindex
