[Unit]
# Production frontend: serve the BUILT SSR app on :3000 (vite preview runs the
# production server bundle from `vite build`). Use this INSTEAD of
# danbyte-frontend (the Vite dev server) in production. Run `make frontend-build`
# first; rebuild + restart this unit to ship UI changes.
Description=Danbyte frontend (built SSR, port 3000)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/danbyte/frontend
Environment=NODE_ENV=production
# A bundle install runs the Node it ships (vendor/node, the one its
# node_modules was built with), so an in-app upgrade to a release on a newer
# Node needs no root; a git install has no vendor/ and uses the host's.
ExecStart=/bin/sh -c 'n=%h/danbyte/vendor/node/bin/node; [ -x "$$n" ] || n=/usr/bin/node; exec "$$n" node_modules/vite/bin/vite.js preview --port 3000 --host 127.0.0.1'
Restart=always
RestartSec=2
# Node exits with 143 on SIGTERM: a stop is not a failure.
SuccessExitStatus=143

# Logs: journalctl --user -fu danbyte-frontend-prod

[Install]
WantedBy=default.target
