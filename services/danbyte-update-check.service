[Unit]
Description=Danbyte update check (refresh the cached release list)
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py update_check

# Triggered every 6h by danbyte-update-check.timer. The Updates page and the
# "Update available" badge read only the list this caches, so a slow or
# unreachable release repo never holds a web worker. A no-op when the update
# check is disabled.
# Logs: journalctl --user -fu danbyte-update-check
