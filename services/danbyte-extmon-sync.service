[Unit]
Description=Danbyte external monitoring sync beat
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py extmon_sync

# Triggered every minute by danbyte-extmon-sync.timer; the beat itself only
# enqueues connections whose own interval has elapsed.
# Logs: journalctl --user -fu danbyte-extmon-sync
