[Unit]
Description=Danbyte vulnerability data refresh (opt-in, server mode only)
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
# "-": a failed fetch must not stop the upkeep below.
ExecStart=-%h/danbyte/.venv/bin/python manage.py vuln_refresh
ExecStart=%h/danbyte/.venv/bin/python manage.py vuln_maintenance

# Triggered daily by danbyte-vuln-refresh.timer. vuln_refresh does nothing
# unless a deployment admin turned vulnerability data on with update source
# "server"; then fetches NVD, OSV, CISA KEV and FIRST EPSS through the SSRF
# guard. vuln_maintenance expires vulnerability exceptions (reopening their
# matches, one notice) and deletes resolved matches older than 365 days; it
# contacts nothing outside the server but the tenants' own channels.
# Logs: journalctl --user -fu danbyte-vuln-refresh
