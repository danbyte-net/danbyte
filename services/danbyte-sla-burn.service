[Unit]
Description=Danbyte SLA burn-rate alerts
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py sla_burn

# Triggered every minute by danbyte-sla-burn.timer.
# Logs: journalctl --user -fu danbyte-sla-burn
