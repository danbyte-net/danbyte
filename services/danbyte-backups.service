[Unit]
Description=Danbyte scheduled backups tick
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py run_backups

# Triggered every 5 minutes by danbyte-backups.timer; the backup itself runs
# on the RQ workers.
# Logs: journalctl --user -fu danbyte-backups
