[Unit]
Description=Danbyte SLA figures (open, close and freeze periods)
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py sla_compute

# Triggered every 15 minutes by danbyte-sla.timer.
# Logs: journalctl --user -fu danbyte-sla
