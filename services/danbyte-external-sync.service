[Unit]
Description=Danbyte external sync beat (Windows DHCP/DNS)
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py external_sync

# Triggered every minute by danbyte-external-sync.timer.
# Logs: journalctl --user -fu danbyte-external-sync
