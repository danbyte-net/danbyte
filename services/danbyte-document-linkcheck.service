[Unit]
Description=Danbyte document dead-link sweep
After=network.target
Wants=danbyte-infra.service

[Service]
Type=oneshot
WorkingDirectory=%h/danbyte
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/danbyte/.venv/bin/python manage.py document_linkcheck

# Triggered daily by danbyte-document-linkcheck.timer. Each external-link
# document gets a short, SSRF-guarded GET; a 4xx/5xx, timeout, or SSRF rejection
# marks the link broken so it surfaces in the UI without anyone clicking it.
# Logs: journalctl --user -fu danbyte-document-linkcheck
