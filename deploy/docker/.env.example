# Danbyte container stack - copy to `.env` at the repo root and edit.
#   cp deploy/docker/.env.example .env
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ─── Required secrets ────────────────────────────────────────────────────────
# Django's SECRET_KEY. Unique per deployment; changing it logs everyone out.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Encrypts stored credentials (SNMP/SSH/SMTP/LDAP). REQUIRED when DEBUG=False.
# Do NOT change once secrets are stored - it makes them undecryptable.
MONITORING_SECRET_KEY=change-me-to-another-long-random-string
# Postgres password (used by both the db and the app).
DB_PASSWORD=change-me

# ─── Hostnames / TLS ─────────────────────────────────────────────────────────
# Comma-separated hosts/IPs this instance answers on (no scheme, no port).
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST (scheme + host [+ port]). Set to the
# URL(s) you actually browse to, e.g. https://danbyte.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Set True when TLS terminates in front of the stack (enables secure cookies,
# HSTS, and the https redirect). Leave False for plain-HTTP local trials.
DANBYTE_HTTPS=False

# ─── Sizing / ports ──────────────────────────────────────────────────────────
# Published HTTP + HTTPS ports on the host (nginx listens on 80/443 inside).
# The container ships a self-signed cert for :443 so HTTPS-forcing browsers work.
HTTP_PORT=8080
HTTPS_PORT=8443
# Number of background worker processes.
RQ_WORKERS=4

# ─── Database name/user (defaults are fine) ──────────────────────────────────
DB_NAME=danbyte
DB_USER=danbyte

# ─── Optional: auto-create the first admin on first boot ─────────────────────
# Uncomment these AND the matching lines in docker-compose.prod.yml (backend).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com
