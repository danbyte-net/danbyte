# ───────────────────────────────────────────────────────────────────────────
# Danbyte - single-port (443) reverse proxy.
#
# GENERATED by `make proxy-install` from this template. Don't edit the installed
# copy in /etc/nginx/ - edit this file and re-run `make proxy-install`.
# Placeholders (@@NAME@@) are substituted at install time.
#
# Everything reachable on one HTTPS origin:
#     https://@@SERVER_NAME@@/          → SPA          (Vite dev server :3000)
#     https://@@SERVER_NAME@@/api/      → Django API   (:8000)
#     https://@@SERVER_NAME@@/admin/    → Django admin (:8000)
#     https://@@SERVER_NAME@@/docs/     → Zensical docs(:8001)
# ───────────────────────────────────────────────────────────────────────────

# Map for websocket upgrades (Vite HMR + any future live features).
map $http_upgrade $danbyte_conn_upgrade {
    default upgrade;
    ''      close;
}

# Plain HTTP → redirect to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAME@@;
    # HTTP-01 for the site's own certificate (Settings → Updates → Site
    # certificate): the CA fetches the token over plain HTTP, Danbyte answers.
    location /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # HTTP/2 form is chosen by the renderer (make proxy-install) from the
    # installed nginx version: 1.25.1+ gets the standalone `http2 on;` directive
    # (@@H2_DIRECTIVE@@) with a bare `listen … ssl`, older nginx (e.g. 1.24 on
    # Ubuntu 24.04) gets `listen … ssl http2` via @@H2_LISTEN@@, where the
    # standalone directive is an unknown-directive error. One template, no
    # deprecation warning on new nginx, no breakage on old.
    listen 443 ssl@@H2_LISTEN@@;
    listen [::]:443 ssl@@H2_LISTEN@@;
@@H2_DIRECTIVE@@
    server_name @@SERVER_NAME@@;

    ssl_certificate     @@CERT@@;
    ssl_certificate_key @@KEY@@;

    # Allow reasonably large API payloads (bulk imports etc.).
    client_max_body_size 512m;

    # ── Documentation (Zensical, :8001). Trailing slash strips the /docs prefix
    #    upstream; the built docs use relative links so they live happily here.
    location /docs/ {
        proxy_pass http://127.0.0.1:8001/;
        # The upstream doesn't know it's mounted under /docs, so its own
        # redirects (notably the add-a-trailing-slash one) come back without
        # the prefix and land on the SPA as a 404 (#123). Put it back.
        proxy_redirect / /docs/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Backup archives: multi-GB uploads and downloads, streamed.
    location /api/backups/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Take the whole upload to disk before gunicorn sees it, and buffer
        # the whole download: a sync worker is killed after GUNICORN_TIMEOUT,
        # so a transfer running at the client's speed died after a minute
        # (#229). Needs free space for one archive in nginx's temp dir.
        proxy_request_buffering on;
        proxy_max_temp_file_size 10240m;
        proxy_read_timeout 600s;
        client_max_body_size 8g;
    }
    # ── Django REST API.
    # The same token path over HTTPS - a CA that followed the redirect above.
    location /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Django admin (+ its static assets).
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Every block that reaches Django says the request came in over HTTPS:
    # without it Django redirects to the same https:// URL, which comes back
    # through the same block, forever (#240).
    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # ── Uploaded media - Django serves /media/ itself, checking access.
    location /media/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Presence WebSocket (Django Channels, :8000). Needs the upgrade headers.
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $danbyte_conn_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # ── SPA (Vite dev server, :3000). Needs the websocket upgrade for HMR.
    #    For a production build, point this at Django/your static host instead.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $danbyte_conn_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # "Danbyte is updating" page instead of a raw 502 when the backend is down.
    error_page 502 503 504 @danbyte_maintenance;
    location @danbyte_maintenance {
        root @@MAINTENANCE_ROOT@@;
        internal;
        add_header Retry-After 30 always;
        # nginx serves a static file for GET and HEAD only; a POST that lands
        # here (an API call whose backend just died) would come back as its
        # bare "405 Not Allowed" page. Say what happened instead.
        if ($request_method !~ ^(GET|HEAD)$) {
            add_header Content-Type application/json always;
            return 503 '{"detail":"Danbyte is restarting or the request outran the backend - try again in a moment."}';
        }
        rewrite ^ /maintenance.html break;
    }
}
