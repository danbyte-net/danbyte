       "type": "string",
       "x-prtg-meta": {
        "class": "combo",
        "sortIndex": 1,
        "options": {
         "0": "Set sensor to [b]down[/b] status immediately",
         "1": "Set sensor to [b]warning[/b] status for 1 interval, then set to [b]down[/b] status (default)",
         "2": "Set sensor to [b]warning[/b] status for 2 intervals, then set to [b]down[/b] status",
         "3": "Set sensor to [b]warning[/b] status for 3 intervals, then set to [b]down[/b] status",
         "4": "Set sensor to [b]warning[/b] status for 4 intervals, then set to [b]down[/b] status",
         "5": "Set sensor to [b]warning[/b] status for 5 intervals, then set to [b]down[/b] status"
        }
       }
      },
